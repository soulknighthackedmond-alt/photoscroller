# Photoscroller environment
# Copy to .env for local runs, or paste these into Coolify's Environment Variables tab.

# The password for the whole app: every page, every API call and every photo.
# CHANGE THIS. Default when unset: changeme
APP_PASSWORD=changeme

# Older name for the same password. Still read, so an existing deployment keeps working.
# UPLOAD_PASSWORD=changeme

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
# If unset it is derived from APP_PASSWORD (fine for a hobby box, weak if the password is weak).
SESSION_SECRET=

# Where albums are stored. In Docker this should be the mounted volume.
DATA_DIR=./data

# How long a login lasts, in hours (default 720 = 30 days)
SESSION_TTL_HOURS=720

# Max size of a single image, in MB (default 40)
MAX_FILE_MB=40

# Max files accepted in one upload request (default 500)
MAX_FILES=500

# Port the server listens on (Coolify sets this itself for Docker builds)
PORT=3000
