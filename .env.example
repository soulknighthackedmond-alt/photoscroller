# Photoscroller environment
# Copy to .env for local runs, or paste these into Coolify's Environment Variables tab.

# Password required to upload / delete. CHANGE THIS. Default when unset: admin
UPLOAD_PASSWORD=admin

# Secret used to sign the login cookie. Generate with: openssl rand -hex 32
# If unset it is derived from UPLOAD_PASSWORD (fine for a hobby box, weak if the password is weak).
SESSION_SECRET=

# Where albums are stored. In Docker this should be the mounted volume.
DATA_DIR=./data

# How long a login lasts, in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Max size of a single image, in MB (default 40)
MAX_FILE_MB=40

# Port the server listens on (Coolify sets this itself for Docker builds)
PORT=3000
